# 复制为 .env 并填入你的 key：  cp .env.example .env
# （.env 已被 .gitignore 忽略，不会提交到仓库）

# ── 大模型 API（run_e0 / experiments 脚本默认读这个变量名）────────────
LLM_API_KEY=sk-your-key-here

# 可选：模型与接口地址（不写就用命令行默认值 deepseek-chat / https://api.deepseek.com）
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
# 思考型模型（先推理再回答）建议调大总预算：
# LLM_MAX_TOKENS=4096

# ── 向量 embedding ─────────────────────────────────────────────────
# 默认走本地 bge（--embed-backend local），不需要 key；
# 仅当你要用 --embed-backend api 时才需要：
# EMBED_API_KEY=sk-your-embed-key

# ── 本地模型下载（国内建议）───────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com

# ── 本地向量模型用 GPU（可选）────────────────────────────────────
# 装好 CUDA 版 torch 后，auto 会自动用 GPU；也可强制指定：
# EMBED_DEVICE=cuda:0
