# 复制为 .env 并填入你的 key：  cp .env.example .env
# （.env 已被 .gitignore 忽略，不会提交到仓库）

# ── 硅基流动 API（query 生成 + 闭卷筛选）──────────────────────────
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 生成 10000 条 query 时使用的模型（按你账号可用模型修改）
QUERY_GEN_MODEL=deepseek-ai/DeepSeek-V3

# 闭卷筛选模型列表：configs/filter_models.txt（一行一个）
